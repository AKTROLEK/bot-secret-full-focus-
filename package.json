{
  "name": "full-streamer-system",
  "version": "1.0.0",
  "description": "Comprehensive Discord bot system for streamer management with advanced features",
  "main": "src/bot/index.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/bot/index.js",
    "start": "node src/bot/index.js",
    "dashboard": "cd dashboard && npm run dev",
    "build": "npm run build:dashboard",
    "build:dashboard": "cd dashboard && npm run build",
    "deploy": "vercel --prod",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio"
  },
  "keywords": [
    "discord",
    "bot",
    "streamer",
    "management",
    "analytics",
    "credit-system"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "discord.js": "^14.14.1",
    "@prisma/client": "^5.8.1",
    "openai": "^4.26.0",
    "axios": "^1.6.5",
    "dotenv": "^16.3.1",
    "node-cron": "^3.0.3",
    "googleapis": "^131.0.0",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "prisma": "^5.8.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
